# Package config for the wemod_enhancer install tree.
#
# Provides the imported target:
#   wemod_enhancer::version — version.dll proxy (ASAR fuse patcher)
#
# Usage:
#   find_package(wemod_enhancer CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE wemod_enhancer::version)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/wemod_enhancer-targets.cmake")

check_required_components(wemod_enhancer)
