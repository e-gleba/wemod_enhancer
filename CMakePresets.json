{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "llvm-mingw-x86_64",
            "displayName": "LLVM-MinGW Windows x86-64",
            "description": "Cross-compile version.dll for Windows x86-64 from Linux (DLL only, no GUI)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "x86_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "msvc",
            "displayName": "Microsoft Visual C++ x86-64",
            "description": "Build version.dll natively on Windows with MSVC (DLL only, no GUI)",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "set"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "clang-windows-amd64",
            "displayName": "Clang Windows AMD64 (MSVC ABI)",
            "description": "Native Windows 64-bit version.dll using pure Clang (GNU driver, MSVC ABI) with Ninja (DLL only, no GUI)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
                "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc",
                "CMAKE_RC_COMPILER": "llvm-rc",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64",
                "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64",
                "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "gui-base",
            "description": "Shared settings for the GUI presets. GUI presets are mutually exclusive with the DLL presets: a GUI configure never builds version.dll (the GUI downloads it from the GitHub releases at runtime). GUI builds use RelWithDebInfo so releases stay debuggable",
            "hidden": true,
            "cacheVariables": {
                "WEMOD_ENHANCER_BUILD_GUI": "ON"
            }
        },
        {
            "name": "gui-windows-msvc-amd64",
            "displayName": "GUI Windows AMD64 (MSVC)",
            "description": "Build wemod_enhancer_gui.exe natively on Windows x86-64 with MSVC (GUI only, no version.dll)",
            "inherits": [
                "msvc",
                "gui-base"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "gui-windows-msvc-arm64",
            "displayName": "GUI Windows ARM64 (MSVC)",
            "description": "Build wemod_enhancer_gui.exe natively on Windows ARM64 with MSVC (GUI only, no version.dll; needs an ARM64 host, e.g. the windows-11-arm CI runner)",
            "inherits": [
                "msvc",
                "gui-base"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "arm64",
                "strategy": "set"
            },
            "toolset": {
                "value": "host=arm64",
                "strategy": "set"
            }
        },
        {
            "name": "gui-windows-clang-amd64",
            "displayName": "GUI Windows AMD64 (Clang, MSVC ABI)",
            "description": "Build wemod_enhancer_gui.exe natively on Windows x86-64 with pure Clang + lld-link (GUI only, no version.dll)",
            "inherits": [
                "clang-windows-amd64",
                "gui-base"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "gui-windows-llvm-mingw-amd64",
            "displayName": "GUI Windows AMD64 (LLVM-MinGW cross)",
            "description": "Cross-build wemod_enhancer_gui.exe for Windows x86-64 from Linux with LLVM-MinGW (GUI only, no version.dll)",
            "inherits": [
                "llvm-mingw-x86_64",
                "gui-base"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "gui-linux-gcc-amd64",
            "displayName": "GUI Linux AMD64 (GCC)",
            "description": "Build wemod_enhancer_gui.elf natively on Linux x86-64 with GCC (GUI only, no version.dll)",
            "inherits": "gui-base",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "gui-linux-clang-amd64",
            "displayName": "GUI Linux AMD64 (Clang)",
            "description": "Build wemod_enhancer_gui.elf natively on Linux x86-64 with Clang (GUI only, no version.dll)",
            "inherits": "gui-linux-gcc-amd64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "gui-linux-gcc-arm64",
            "displayName": "GUI Linux ARM64 (GCC)",
            "description": "Build wemod_enhancer_gui.elf natively on Linux ARM64 with GCC (GUI only, no version.dll)",
            "inherits": "gui-linux-gcc-amd64",
            "binaryDir": "${sourceDir}/build/${presetName}"
        }
    ],
    "buildPresets": [
        {
            "name": "llvm-mingw-x86_64",
