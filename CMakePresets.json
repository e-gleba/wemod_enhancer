{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC (Windows, AMD64)",
      "description": "Windows host build with the Visual Studio MSVC toolchain.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "llvm-mingw-x86_64",
      "displayName": "LLVM-MinGW (Windows AMD64 target)",
      "description": "Cross-compiles Windows AMD64 binaries from any host with the auto-downloaded LLVM-MinGW toolchain.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/llvm-mingw-x86_64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/llvm_mingw.cmake",
        "LLVM_MINGW_TARGET": "x86_64-w64-mingw32",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "linux-native",
      "displayName": "Linux native (GCC/Clang)",
      "description": "Native Linux build. Produces the GUI ELF; the proxy DLL is Win32-only and is built by the llvm-mingw preset.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/linux-native",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "WEMOD_ENHANCER_BUILD_GUI": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "clang-windows-amd64",
      "displayName": "Clang (Windows, MSVC ABI)",
      "description": "Windows host build with Clang targeting the MSVC ABI (clang-cl).",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/clang-windows-amd64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "llvm-mingw-x86_64-debug",
      "configurePreset": "llvm-mingw-x86_64",
      "configuration": "Debug"
    },
    {
      "name": "llvm-mingw-x86_64-release",
      "configurePreset": "llvm-mingw-x86_64",
      "configuration": "Release"
    },
    {
      "name": "linux-native-debug",
      "configurePreset": "linux-native",
      "configuration": "Debug",
      "targets": ["wemod_enhancer_gui"]
    },
    {
      "name": "linux-native-release",
      "configurePreset": "linux-native",
      "configuration": "Release",
      "targets": ["wemod_enhancer_gui"]
    },
    {
      "name": "clang-windows-amd64-debug",
      "configurePreset": "clang-windows-amd64",
      "configuration": "Debug"
    },
    {
      "name": "clang-windows-amd64-release",
      "configurePreset": "clang-windows-amd64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-windows-amd64-debug",
      "configurePreset": "clang-windows-amd64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-windows-amd64-release",
      "configurePreset": "clang-windows-amd64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configurations": ["Release"],
      "generators": [
        {
          "type": "ZIP",
          "packageName": "wemod_enhancer",
          "packageVersion": "${projectVersion}",
          "packageDirectory": "dist"
        }
      ]
    },
    {
      "name": "llvm-mingw-x86_64-release",
      "configurePreset": "llvm-mingw-x86_64",
      "configurations": ["Release"],
      "generators": [
        {
          "type": "TXZ",
          "packageName": "wemod_enhancer",
          "packageVersion": "${projectVersion}",
          "packageDirectory": "dist"
        }
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "msvc-full",
      "steps": [
        {
          "type": "configure",
          "name": "msvc"
        },
        {
          "type": "build",
          "name": "msvc-debug"
        },
        {
          "type": "build",
          "name": "msvc-release"
        },
        {
          "type": "test",
          "name": "msvc-debug"
        },
        {
          "type": "test",
          "name": "msvc-release"
        },
        {
          "type": "package",
          "name": "msvc-release"
        }
      ]
    },
    {
      "name": "llvm-mingw-x86_64-full",
      "steps": [
        {
          "type": "configure",
          "name": "llvm-mingw-x86_64"
        },
        {
          "type": "build",
          "name": "llvm-mingw-x86_64-debug"
        },
        {
          "type": "build",
          "name": "llvm-mingw-x86_64-release"
        },
        {
          "type": "package",
          "name": "llvm-mingw-x86_64-release"
        }
      ]
    },
    {
      "name": "linux-native-full",
      "steps": [
        {
          "type": "configure",
          "name": "linux-native"
        },
        {
          "type": "build",
          "name": "linux-native-release"
        }
      ]
    },
    {
      "name": "clang-windows-amd64-full",
      "steps": [
        {
          "type": "configure",
          "name": "clang-windows-amd64"
        },
        {
          "type": "build",
          "name": "clang-windows-amd64-debug"
        },
        {
          "type": "build",
          "name": "clang-windows-amd64-release"
        },
        {
          "type": "test",
          "name": "clang-windows-amd64-debug"
        },
        {
          "type": "test",
          "name": "clang-windows-amd64-release"
        }
      ]
    }
  ]
}
