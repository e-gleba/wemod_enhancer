{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows_llvm_mingw_amd64",
            "displayName": "Windows AMD64 (LLVM-MinGW cross)",
            "description": "Cross-build the self-contained package for Windows x86-64 from Linux with LLVM-MinGW (wemod_enhancer_gui.exe + version.dll + wemod_enhancer.py)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "x86_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows_msvc_amd64",
            "displayName": "Windows AMD64 (MSVC)",
            "description": "Build the self-contained package natively on Windows x86-64 with MSVC (wemod_enhancer_gui.exe + version.dll + wemod_enhancer.py)",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "set"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows_clang_amd64",
            "displayName": "Windows AMD64 (Clang, MSVC ABI)",
            "description": "Build the self-contained package natively on Windows x86-64 with pure Clang (GNU driver, MSVC ABI) + lld-link (wemod_enhancer_gui.exe + version.dll + wemod_enhancer.py)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
                "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc",
                "CMAKE_RC_COMPILER": "llvm-rc",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64",
                "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64",
                "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux_gcc_amd64",
            "displayName": "Linux AMD64 (GCC)",
            "description": "Build the self-contained package natively on Linux x86-64 with GCC (wemod_enhancer_gui.elf + Windows version.dll via nested llvm-mingw + wemod_enhancer.py)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux_clang_amd64",
            "displayName": "Linux AMD64 (Clang)",
            "description": "Build the self-contained package natively on Linux x86-64 with Clang (wemod_enhancer_gui.elf + Windows version.dll via nested llvm-mingw + wemod_enhancer.py)",
            "inherits": "linux_gcc_amd64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "linux_gcc_arm64",
            "displayName": "Linux ARM64 (GCC)",
            "description": "Build the self-contained package natively on Linux ARM64 with GCC (wemod_enhancer_gui.elf + Windows version.dll via nested llvm-mingw + wemod_enhancer.py)",
            "inherits": "linux_gcc_amd64",
            "binaryDir": "${sourceDir}/build/${presetName}"
        }
    ],
    "buildPresets": [
        {
            "name": "windows_llvm_mingw_amd64",
            "displayName": "Windows AMD64 (LLVM-MinGW) RelWithDebInfo",
            "configurePreset": "windows_llvm_mingw_amd64",
            "configuration": "RelWithDebInfo"
