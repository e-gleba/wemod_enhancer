            "configurePreset": "gui-linux-clang-amd64",
            "configuration": "RelWithDebInfo",
            "targets": [
                "wemod_enhancer_gui"
            ]
        },
        {
            "name": "gui-linux-gcc-arm64",
            "displayName": "GUI Linux ARM64 (GCC) RelWithDebInfo",
            "configurePreset": "gui-linux-gcc-arm64",
            "configuration": "RelWithDebInfo",
            "targets": [
                "wemod_enhancer_gui"
            ]
        }
    ],
