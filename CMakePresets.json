{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows_llvm_mingw_amd64",
            "displayName": "Windows AMD64 (LLVM-MinGW cross)",
            "description": "Cross-build the Windows x86-64 package from Linux with LLVM-MinGW",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "x86_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows_msvc_amd64",
            "displayName": "Windows AMD64 (MSVC)",
            "description": "Build the Windows x86-64 package natively with MSVC",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows_clang_amd64",
            "displayName": "Windows AMD64 (Clang, MSVC ABI)",
            "description": "Build the Windows x86-64 package natively with Clang (GNU driver) + lld-link",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
                "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
                "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/2.0": {
                    "intelliSenseOptions": {
                        "useCompilerDefaults": true
                    }
                }
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux_gcc_amd64",
            "displayName": "Linux AMD64 (GCC)",
            "description": "Build the Linux x86-64 package natively with GCC (version.dll via nested llvm-mingw)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux_clang_amd64",
            "displayName": "Linux AMD64 (Clang)",
            "description": "Build the Linux x86-64 package natively with Clang (version.dll via nested llvm-mingw)",
            "inherits": "linux_gcc_amd64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "linux_gcc_arm64",
            "displayName": "Linux ARM64 (GCC)",
            "description": "Build the Linux ARM64 package natively with GCC (version.dll via nested llvm-mingw)",
            "inherits": "linux_gcc_amd64",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "linux_clang_arm64",
            "displayName": "Linux ARM64 (Clang)",
            "description": "Build the Linux ARM64 package natively with Clang (version.dll via nested llvm-mingw)",
            "inherits": "linux_gcc_arm64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows_llvm_mingw_amd64",
            "displayName": "Windows AMD64 (LLVM-MinGW) RelWithDebInfo",
            "configurePreset": "windows_llvm_mingw_amd64",
