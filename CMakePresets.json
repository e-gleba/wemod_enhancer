{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "llvm-mingw-x86_64",
            "displayName": "LLVM-MinGW Windows x86-64",
            "description": "Cross-compile version.dll for Windows x86-64 from Linux (DLL only, no GUI)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "x86_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "msvc",
            "displayName": "Microsoft Visual C++ x86-64",
            "description": "Build version.dll natively on Windows with MSVC (DLL only, no GUI)",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "set"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "clang-windows-amd64",
            "displayName": "Clang Windows AMD64 (MSVC ABI)",
            "description": "Native Windows 64-bit version.dll using pure Clang (GNU driver, MSVC ABI) with Ninja (DLL only, no GUI)",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
                "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc",
                "CMAKE_RC_COMPILER": "llvm-rc",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64",
                "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64",
                "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "gui-base",
            "description": "Shared settings for the GUI presets. Every GUI configure also builds version.dll (Windows target: in-tree add_subdirectory; Linux host: nested llvm-mingw ExternalProject) and installs the Python patcher, so GUI packages are fully self-contained (gui + wemod_enhancer.py + version.dll) - the GUI downloads nothing at runtime. GUI builds use RelWithDebInfo so releases stay debuggable. CMAKE_MSVC_RUNTIME_LIBRARY is set directory-wide so the CPM-built imgui library gets the same static CRT as the GUI target itself - a target-local property alone links imgui as MD against the GUI's MT and fails with LNK2038",
            "hidden": true,
            "cacheVariables": {
                "WEMOD_ENHANCER_BUILD_GUI": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            }
        },
        {
            "name": "gui-windows-msvc-amd64",
            "displayName": "GUI Windows AMD64 (MSVC)",
            "description": "Build the self-contained GUI package natively on Windows x86-64 with MSVC (exe + version.dll + wemod_enhancer.py)",
            "inherits": [
                "msvc",
                "gui-base"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "gui-windows-clang-amd64",
            "displayName": "GUI Windows AMD64 (Clang, MSVC ABI)",
            "description": "Build the self-contained GUI package natively on Windows x86-64 with pure Clang + lld-link (exe + version.dll + wemod_enhancer.py)",
            "inherits": [
                "clang-windows-amd64",
                "gui-base"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "gui-windows-llvm-mingw-amd64",
            "displayName": "GUI Windows AMD64 (LLVM-MinGW cross)",
            "description": "Cross-build the self-contained GUI package for Windows x86-64 from Linux with LLVM-MinGW (exe + version.dll + wemod_enhancer.py)",
            "inherits": [
                "llvm-mingw-x86_64",
                "gui-base"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "gui-linux-gcc-amd64",
            "displayName": "GUI Linux AMD64 (GCC)",
            "description": "Build the self-contained GUI package natively on Linux x86-64 with GCC (elf + Windows version.dll via nested llvm-mingw + wemod_enhancer.py)",
            "inherits": "gui-base",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "gui-linux-clang-amd64",
            "displayName": "GUI Linux AMD64 (Clang)",
            "description": "Build the self-contained GUI package natively on Linux x86-64 with Clang (elf + Windows version.dll via nested llvm-mingw + wemod_enhancer.py)",
            "inherits": "gui-linux-gcc-amd64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "gui-linux-gcc-arm64",
            "displayName": "GUI Linux ARM64 (GCC)",
            "description": "Build the self-contained GUI package natively on Linux ARM64 with GCC (elf + Windows version.dll via nested llvm-mingw + wemod_enhancer.py)",
            "inherits": "gui-linux-gcc-amd64",
            "binaryDir": "${sourceDir}/build/${presetName}"
        }
    ],
    "buildPresets": [
        {
            "name": "llvm-mingw-x86_64",
            "displayName": "LLVM-MinGW Windows x86-64 Release",
            "configurePreset": "llvm-mingw-x86_64",
            "configuration": "Release"
